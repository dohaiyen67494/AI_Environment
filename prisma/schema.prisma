// CareFlow Prisma Schema
// Secure Medical Appointment & Encrypted Records System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Enums
// =============================================================================

enum Role {
  ADMIN
  DOCTOR
  PATIENT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum PolicyStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

// =============================================================================
// Core User & Clinic Models
// =============================================================================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  role         Role     @default(PATIENT)
  fullName     String
  phone        String?
  tideId       String?  @unique // TideCloak subject / identifier
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  doctorProfile       Doctor?
  patientAppointments Appointment[]     @relation("PatientAppointments")
  patientRecords      EncryptedRecord[] @relation("PatientRecords")
  auditLogs           AuditLog[]

  @@map("users")
}

model Clinic {
  id        String   @id @default(uuid())
  name      String
  address   String
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctors Doctor[]

  @@map("clinics")
}

model Doctor {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinicId      String
  clinic        Clinic   @relation(fields: [clinicId], references: [id])
  specialty     String
  licenseNumber String   @unique
  bio           String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shifts       Shift[]
  slots        Slot[]
  appointments Appointment[]
  records      EncryptedRecord[] @relation("DoctorRecords")

  @@map("doctors")
}

model Service {
  id              String   @id @default(uuid())
  name            String   @unique
  description     String?
  price           Decimal  @db.Decimal(12, 2)
  durationMinutes Int      @default(30)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  appointments Appointment[]

  @@map("services")
}

// =============================================================================
// Scheduling Models (Shift & Slot with Anti-Race-Condition Constraints)
// =============================================================================

model Shift {
  id        String   @id @default(uuid())
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  startTime DateTime
  endTime   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slots Slot[]

  @@index([doctorId, date])
  @@map("shifts")
}

model Slot {
  id        String   @id @default(uuid())
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  shiftId   String
  shift     Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  startTime DateTime
  endTime   DateTime
  isBooked  Boolean  @default(false)
  version   Int      @default(0) // Concurrency control / optimistic locking
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointment Appointment?

  // Anti-collision unique constraint: A doctor cannot have duplicate slots at identical start time
  @@unique([doctorId, startTime])
  @@index([doctorId, startTime, isBooked])
  @@map("slots")
}

// =============================================================================
// Appointment Model (Supports Idempotency Key & Slot 1-to-1 Constraint)
// =============================================================================

model Appointment {
  id             String            @id @default(uuid())
  idempotencyKey String?           @unique // Prevents duplicate submissions on network retries
  patientId      String
  patient        User              @relation("PatientAppointments", fields: [patientId], references: [id])
  doctorId       String
  doctor         Doctor            @relation(fields: [doctorId], references: [id])
  serviceId      String
  service        Service           @relation(fields: [serviceId], references: [id])
  slotId         String            @unique // Unique slot per appointment: DB-level double booking prevention
  slot           Slot              @relation(fields: [slotId], references: [id])
  status         AppointmentStatus @default(CONFIRMED)
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  record EncryptedRecord?

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@map("appointments")
}

// =============================================================================
// Tide Cryptographic Policy & Encrypted Records
// INVARIANT CONSTRAINTS:
// 1. Backend ONLY stores Ciphertext and Signed Policy.
// 2. NO plaintext fields in EncryptedRecord.
// 3. NO fake/mock admin count in database. Tide QEA token must be verified cryptographically.
// =============================================================================

model SignedPolicy {
  id                String       @id @default(uuid())
  policyDefinition  String       @db.Text // Tide QEA Policy JSON / DSL specification
  signedToken       String       @db.Text // Cryptographic signature / Multi-admin signed assertion
  thresholdRequired Int          @default(2) // 2/3 Admin threshold
  totalAdmins       Int          @default(3)
  status            PolicyStatus @default(ACTIVE)
  expiresAt         DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  records EncryptedRecord[]

  @@map("signed_policies")
}

model EncryptedRecord {
  id             String       @id @default(uuid())
  appointmentId  String       @unique
  appointment    Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patientId      String
  patient        User         @relation("PatientRecords", fields: [patientId], references: [id])
  doctorId       String
  doctor         Doctor       @relation("DoctorRecords", fields: [doctorId], references: [id])
  ciphertext     String       @db.Text // Encrypted clinical payload (NO PLAINTEXT ALLOWED)
  iv             String       // Initialization Vector (Base64)
  tag            String       // Auth tag for GCM authentication
  signedPolicyId String
  signedPolicy   SignedPolicy @relation(fields: [signedPolicyId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@map("encrypted_records")
}

// =============================================================================
// Audit Logging
// =============================================================================

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String   // E.g. APPOINTMENT_CREATED, APPOINTMENT_RESCHEDULED, RECORD_SAVED, RECORD_ACCESSED
  resource   String   // Resource name (Appointment, EncryptedRecord, Slot, etc.)
  resourceId String?
  ipAddress  String?
  userAgent  String?
  details    Json?
  timestamp  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([timestamp])
  @@map("audit_logs")
}
