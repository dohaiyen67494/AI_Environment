# =============================================================================
# CareFlow Application Environment Configuration
# =============================================================================

# Server Port (Invariant constraint: API must run on 3333)
PORT=3333
NODE_ENV=development

# Database Connection (PostgreSQL)
POSTGRES_USER=careflow_user
POSTGRES_PASSWORD=careflow_password
POSTGRES_DB=careflow_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://careflow_user:careflow_password@localhost:5432/careflow_db?schema=public"

# TideCloak / Identity & QEA Configuration (Invariant constraint: TideCloak on 8080)
TIDECLOAK_URL="http://localhost:8080"
TIDECLOAK_ADMIN=admin
TIDECLOAK_ADMIN_PASSWORD=admin_password
TIDECLOAK_REALM="careflow"
TIDECLOAK_CLIENT_ID="careflow-backend"
TIDECLOAK_CLIENT_SECRET="tidecloak-secret"

# Application Security
JWT_SECRET="careflow-super-secure-jwt-secret-key-2026"
